{
  description = "Kotiba application";

  nixConfig = {
    extra-substituters = [ "https://cache.xinux.uz" ];
    extra-trusted-public-keys =
      [ "cache.xinux.uz:BXCrtqejFjWzWEB9YuGB7X2MV4ttBur1N8BkwQRdH+0=" ];
  };

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-25.05";
    nixpkgs-unstable.url = "github:nixos/nixpkgs/nixos-unstable";
    flake-parts.url = "github:hercules-ci/flake-parts";
    git-hooks = {
      url = "github:cachix/git-hooks.nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    treefmt-nix = {
      url = "github:numtide/treefmt-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = inputs@{ self, flake-parts, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems =
        [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];

      perSystem = { config, self', inputs', pkgs, system, ... }:
        let
          pkgsUnstable = inputs.nixpkgs-unstable.legacyPackages.${system};

          hl = pkgs.haskell.lib;

          hackageDeps = { ram = null; };

          hp = pkgs.haskell.packages.ghc912.override {
            overrides = self: super:
              {
                brick = hl.dontCheck (hl.doJailbreak super.brick);
                esqueleto = hl.dontCheck (hl.doJailbreak super.esqueleto);
                postgresql-simple =
                  hl.dontCheck (hl.doJailbreak super.postgresql-simple);
                optparse-generic =
                  hl.dontCheck (hl.doJailbreak super.optparse-generic);
                servant = hl.doJailbreak super.servant;
                servant-client =
                  hl.dontCheck (hl.doJailbreak super.servant-client);
                servant-client-core = hl.doJailbreak super.servant-client-core;
                servant-server =
                  hl.dontCheck (hl.doJailbreak super.servant-server);

                # Generated by cabal2nix and committed to avoid IFD.
                # Regenerate with `nix run .#cabal2nix`.
                forgejo = hl.dontCheck
                  (hl.doJailbreak (self.callPackage ./nix/forgejo.nix { }));
                persistent-records = hl.dontCheck (hl.doJailbreak
                  (self.callPackage ./nix/persistent-records.nix { }));

                kotiba =
                  hl.overrideCabal (self.callPackage ./nix/kotiba.nix { })
                  (drv: {
                    # module.nix expects ${package}/share/kotiba/seed.json
                    postInstall = (drv.postInstall or "") + ''
                      install -Dm644 default/seed.json $out/share/kotiba/seed.json
                    '';
                  });
              } // builtins.mapAttrs (name: _:
                hl.dontCheck
                (hl.doJailbreak (self.callPackage ./nix/${name}.nix { })))
              hackageDeps;
          };

          kotiba = hp.kotiba;

          weederBin =
            hl.dontCheck (hl.doJailbreak (hp.callPackage ./nix/weeder.nix { }));

          # Fails when nix/kotiba.nix is out of date with kotiba.cabal.
          cabal2nix-fresh = pkgs.runCommand "kotiba-cabal2nix-fresh" {
            nativeBuildInputs = [ pkgs.cabal2nix ];
          } ''
            cd ${./.}/nix
            cabal2nix .. > $TMPDIR/kotiba.nix
            diff -u kotiba.nix $TMPDIR/kotiba.nix \
              || { echo "nix/kotiba.nix is stale, run: nix run .#cabal2nix"; exit 1; }
            touch $out
          '';

          weeder = (hl.appendConfigureFlags (hl.dontCheck kotiba) [
            "--ghc-option=-fwrite-ide-info"
            "--ghc-option=-hiedir=.hie"
          ]).overrideAttrs (old: {
            pname = "kotiba-weeder";
            nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [ weederBin ];
            postBuild = (old.postBuild or "") + ''
              weeder --hie-directory .hie
            '';
          });

          treefmtEval = inputs.treefmt-nix.lib.evalModule pkgs {
            projectRootFile = "flake.nix";
            programs.fourmolu.enable = true;
            programs.fourmolu.package =
              pkgsUnstable.haskell.packages.ghc912.fourmolu;
            programs.cabal-fmt.enable = true;
            programs.nixfmt.enable = true;
            settings.global.excludes = [
              "nix/kotiba.nix"
              "nix/forgejo.nix"
              "nix/persistent-records.nix"
              "nix/weeder.nix"
            ] ++ map (name: "nix/${name}.nix") (builtins.attrNames hackageDeps);
          };

          pre-commit = inputs.git-hooks.lib.${system}.run {
            src = ./.;
            hooks = {
              treefmt = {
                enable = true;
                package = treefmtEval.config.build.wrapper;
              };
              hlint = {
                enable = true;
                package = hp.hlint;
              };
            };
          };
        in {
          packages.default = kotiba;

          checks = {
            build = kotiba;
            inherit weeder pre-commit cabal2nix-fresh;
          } // pkgs.lib.optionalAttrs pkgs.stdenv.isLinux {
            nixos-test = import ./nix/test.nix self { inherit pkgs; };
          };

          apps.default = {
            type = "app";
            program = "${pkgs.writeShellScript "run-kotiba" ''
              exec ${kotiba}/bin/kotiba "$@"
            ''}";
          };

          # Regenerates every nix/*.nix that comes from cabal2nix:
          #   kotiba   <- local kotiba.cabal
          #   git deps <- source-repository-package stanzas in cabal.project
          #   weeder   <- hackage
          apps.cabal2nix = {
            type = "app";
            program = "${
                pkgs.writeShellApplication {
                  name = "update-cabal2nix";
                  runtimeInputs = with pkgs; [
                    cabal2nix
                    nix-prefetch-git
                    git
                    gawk
                    coreutils
                  ];
                  text = ''
                    root="$(git rev-parse --show-toplevel)"
                    tmp="$(mktemp)"
                    trap 'rm -f "$tmp"' EXIT

                    cd "$root/nix"
                    cabal2nix .. > "$tmp"
                    mv "$tmp" kotiba.nix

                    awk '/location:/ {url=$2} /tag:/ {print url, $2}' ../cabal.project \
                      | while read -r url rev; do
                          name="$(basename "$url" .git)"
                          echo "cabal2nix $name @ $rev"
                          cabal2nix "$url" --revision "$rev" > "$tmp"
                          mv "$tmp" "$name.nix"
                        done

                    ${pkgs.lib.concatStringsSep "\n" (pkgs.lib.mapAttrsToList
                      (name: ver: ''
                        echo "cabal2nix ${name} (hackage)"
                          cabal2nix cabal://${name}${
                            pkgs.lib.optionalString (ver != null) "-${ver}"
                          } > "$tmp"
                          mv "$tmp" ${name}.nix
                      '') hackageDeps)}

                    cabal2nix cabal://weeder-2.10.0 > "$tmp"
                    mv "$tmp" weeder.nix
                  '';
                }
              }/bin/update-cabal2nix";
          };

          devShells.default = pkgs.mkShell {
            buildInputs = with pkgs;
              [
                hp.ghc
                cabal-install
                hp.haskell-language-server
                hp.hlint
                hp.alex
                hp.happy
                hp.ghcid
                hp.implicit-hie
                pkgsUnstable.haskell.packages.ghc912.fourmolu
                haskellPackages.cabal-fmt
                treefmtEval.config.build.wrapper
                cabal2nix

                pkg-config
                zlib
                zlib.dev
                bzip2
                bzip2.dev
                libzip
                libpq
                libpq.dev

                nixd
                statix
                deadnix
                jq
                just
              ] ++ pre-commit.enabledPackages;

            shellHook = ''
              echo "Welcome to kotiba dev shell"

              ${pre-commit.shellHook}

              export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:${pkgs.postgresql}/lib
              export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:${pkgs.libzip}/lib
              export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:${pkgs.bzip2}/lib
              export LIBRARY_PATH=$LIBRARY_PATH:${pkgs.bzip2}/lib
              export NIX_LDFLAGS="$NIX_LDFLAGS -L${pkgs.bzip2}/lib"
            '';

            NIX_CONFIG = "extra-experimental-features = nix-command flakes";
          };

          formatter = treefmtEval.config.build.wrapper;
        };

      flake = {
        nixosModules.default = import ./nix/module.nix self;
        nixosModules.kotiba = self.nixosModules.default;

        hydraJobs = let systems = [ "x86_64-linux" ];
        in {
          kotiba =
            inputs.nixpkgs.lib.genAttrs systems (s: self.packages.${s}.default);
          devShell = inputs.nixpkgs.lib.genAttrs systems
            (s: self.devShells.${s}.default);
        };
      };
    };
}
